# Copy to .env and adjust as needed. All values have working defaults in app/config.py.

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
SPACY_MODEL=en_core_web_sm

# Retrieval
TOP_K_EVIDENCE=5
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# Decision thresholds
SUPPORTED_THRESHOLD=0.70
CONTRADICTED_THRESHOLD=0.70
ABSTAIN_MARGIN=0.15

# Paths
INDEX_DIR=data/indexes
CORPUS_PATH=data/processed/evidence_corpus.jsonl
